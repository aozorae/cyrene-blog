{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cyrene-personal-admin",
  "main": "src/index.ts",
  "tsconfig": "./tsconfig.json",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyrene-personal-admin-db",
      "database_id": "b3abe50a-e055-4ac9-ad60-ddc15659783c",
      "migrations_dir": "./migrations",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
